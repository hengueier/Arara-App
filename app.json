{
  "expo": {
    "name": "Meu Arara",
    "slug": "araramobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "araramobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "arara.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "arara.mobile",
      "versionCode": 13,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#011C58",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#011C58",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48906208-5170-4066-8741-e25df3332a38"
      }
    },
    "owner": "hengueiers-team"
  }
}
